        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam actorStyle awesome\n\nactor \&quot;Admin\&quot; as Admin\nactor \&quot;Student\&quot; as Student\n\nrectangle \&quot;Student Management System\&quot; {\n\n  usecase \&quot;Log in\&quot; as UC_Login\n  usecase \&quot;Log out\&quot; as UC_Logout\n  usecase \&quot;Change password\&quot; as UC_ChangePw\n\n  usecase \&quot;Manage students\&quot; as UC_QLSV\n  usecase \&quot;Add student\&quot; as UC_AddSV\n  usecase \&quot;View student list and details\&quot; as UC_ViewSV\n  usecase \&quot;Update student information\&quot; as UC_UpdSV\n  usecase \&quot;Delete student\&quot; as UC_DelSV\n\n  usecase \&quot;Search &amp; filter students\&quot; as UC_Search\n  usecase \&quot;Search by student ID\&quot; as UC_ID\n  usecase \&quot;Search by full name\&quot; as UC_Name\n  usecase \&quot;Filter list by class\&quot; as UC_Filter\n\n  usecase \&quot;Manage classes\&quot; as UC_QLLop\n  usecase \&quot;Add class\&quot; as UC_AddClass\n  usecase \&quot;Delete class\&quot; as UC_DelClass\n  usecase \&quot;Assign student to class\&quot; as UC_Assign\n  usecase \&quot;View class list\&quot; as UC_ViewClass\n  usecase \&quot;Edit class information\&quot; as UC_EditClass\n\n  usecase \&quot;Dashboard\&quot; as UC_Dash\n  usecase \&quot;View total students\&quot; as UC_TotalSV\n  usecase \&quot;View total classes\&quot; as UC_TotalClass\n  usecase \&quot;View student count per class\&quot; as UC_StatClass\n\n  usecase \&quot;Manage grades\&quot; as UC_QLDiem\n  usecase \&quot;Enter student grades\&quot; as UC_AddScore\n  usecase \&quot;Update grades\&quot; as UC_UpdScore\n\n  usecase \&quot;View personal information\&quot; as UC_Profile\n  usecase \&quot;View student ID, name, address...\&quot; as UC_ProfileInfo\n  usecase \&quot;View enrolled classes\&quot; as UC_MyClasses\n\n  usecase \&quot;View class information\&quot; as UC_ClassInfo\n  usecase \&quot;View class code and name\&quot; as UC_ClassCode\n  usecase \&quot;View class schedule\&quot; as UC_Schedule\n\n  usecase \&quot;View grades\&quot; as UC_Score\n  usecase \&quot;View own GPA\&quot; as UC_GPA\n  usecase \&quot;View grades by subject and semester\&quot; as UC_ScoreDetail\n}\n\n&#39; ----- Common -----\nAdmin --&gt; UC_Login\nStudent --&gt; UC_Login\nAdmin --&gt; UC_Logout\nStudent --&gt; UC_Logout\nAdmin --&gt; UC_ChangePw\nStudent --&gt; UC_ChangePw\n\n&#39; ----- Admin -----\nAdmin --&gt; UC_QLSV\nAdmin --&gt; UC_Search\nAdmin --&gt; UC_QLLop\nAdmin --&gt; UC_Dash\nAdmin --&gt; UC_QLDiem\n\nUC_QLSV ..&gt; UC_AddSV : &lt;&lt;include&gt;&gt;\nUC_QLSV ..&gt; UC_ViewSV : &lt;&lt;include&gt;&gt;\nUC_QLSV ..&gt; UC_UpdSV : &lt;&lt;include&gt;&gt;\nUC_QLSV ..&gt; UC_DelSV : &lt;&lt;include&gt;&gt;\n\nUC_Search ..&gt; UC_ID : &lt;&lt;include&gt;&gt;\nUC_Search ..&gt; UC_Name : &lt;&lt;include&gt;&gt;\nUC_Search ..&gt; UC_Filter : &lt;&lt;include&gt;&gt;\n\nUC_QLLop ..&gt; UC_AddClass : &lt;&lt;include&gt;&gt;\nUC_QLLop ..&gt; UC_DelClass : &lt;&lt;include&gt;&gt;\nUC_QLLop ..&gt; UC_Assign : &lt;&lt;include&gt;&gt;\nUC_QLLop ..&gt; UC_ViewClass : &lt;&lt;include&gt;&gt;\nUC_QLLop ..&gt; UC_EditClass : &lt;&lt;include&gt;&gt;\n\nUC_Dash ..&gt; UC_TotalSV : &lt;&lt;include&gt;&gt;\nUC_Dash ..&gt; UC_TotalClass : &lt;&lt;include&gt;&gt;\nUC_Dash ..&gt; UC_StatClass : &lt;&lt;include&gt;&gt;\n\nUC_QLDiem ..&gt; UC_AddScore : &lt;&lt;include&gt;&gt;\nUC_QLDiem ..&gt; UC_UpdScore : &lt;&lt;include&gt;&gt;\n\n&#39; ----- Student -----\nStudent --&gt; UC_Profile\nStudent --&gt; UC_ClassInfo\nStudent --&gt; UC_Score\n\nUC_Profile ..&gt; UC_ProfileInfo : &lt;&lt;include&gt;&gt;\nUC_Profile ..&gt; UC_MyClasses : &lt;&lt;include&gt;&gt;\n\nUC_ClassInfo ..&gt; UC_ClassCode : &lt;&lt;include&gt;&gt;\nUC_ClassInfo ..&gt; UC_Schedule : &lt;&lt;include&gt;&gt;\n\nUC_Score ..&gt; UC_GPA : &lt;&lt;include&gt;&gt;\nUC_Score ..&gt; UC_ScoreDetail : &lt;&lt;include&gt;&gt;\n@enduml&quot;,&#xa; 